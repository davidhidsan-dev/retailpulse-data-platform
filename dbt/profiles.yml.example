retailpulse:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | int }}"
      user: "{{ env_var('POSTGRES_USER', 'retailpulse_user') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'retailpulse_password') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'retailpulse') }}"
      schema: "{{ env_var('DBT_SCHEMA', 'analytics') }}"
      threads: 4
